{
  "tools": [
    {
      "name": "generate-ai-video",
      "description": "Generate AI video",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "Prompt for AI video generation"
          },
          "duration": {
            "enum": [
              "5",
              "10"
            ],
            "type": "number",
            "default": "5",
            "description": "Duration of the video in seconds"
          },
          "imageUrl": {
            "type": "string",
            "default": "",
            "description": "Image URL to generate video from"
          },
          "isPrivate": {
            "enum": [
              "true",
              "false"
            ],
            "type": "boolean",
            "default": "false",
            "description": "Set to true to generate a private video (not supported for Explorer plan)"
          },
          "aspectRation": {
            "enum": [
              "16:9",
              "4:3",
              "1:1"
            ],
            "type": "string",
            "default": "16:9",
            "description": "Aspect ratio of the video"
          },
          "collectionId": {
            "type": "string",
            "default": "",
            "description": "Collection ID where the generated video will be stored. If not provided, the default collection will be used. To obtain a collection ID, use the get-collections tool."
          },
          "negative_prompt": {
            "type": "string",
            "description": "Text prompt to exclude from the image"
          }
        }
      }
    },
